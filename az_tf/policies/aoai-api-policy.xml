<policies>
  <inbound>
    <base />
    <set-backend-service backend-id="foundry-openai" />
    <authentication-managed-identity resource="https://cognitiveservices.azure.com" output-token-variable-name="msi-token" ignore-error="false" />
    <set-header name="Authorization" exists-action="override">
      <value>@("Bearer " + (string)context.Variables["msi-token"])</value>
    </set-header>
    <!-- "Track token usage" (llm-emit-token-metric) — supported on Consumption.
         "Manage token consumption" (llm-token-limit) is NOT available on
         Consumption (Developer/Basic/Standard/Premium only), same family of
         restriction as rate-limit-by-key/quota-by-key. -->
    <llm-emit-token-metric namespace="genai-gateway">
      <dimension name="Subscription ID" />
      <dimension name="API ID" />
    </llm-emit-token-metric>
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
