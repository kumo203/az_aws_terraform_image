# This file only documents the keys docker-compose.yml expects.
# The real .env is generated by setup-env.bat / setup-env.ps1 and is
# git-ignored (it contains a LiteLLM virtual key and the Postgres password).

# Points at the dedicated "openwebui" database on the az_litellm_tf Postgres
# Flexible Server (same admin login as LiteLLM, different database name).
DATABASE_URL=postgresql://<user>:<password>@<postgres-fqdn>:5432/openwebui?sslmode=require

# LiteLLM gateway's OpenAI-compatible base URL.
OPENAI_API_BASE_URL=https://<litellm-gateway-fqdn>/v1

# A LiteLLM virtual key (from /key/generate) - never the master key.
OPENAI_API_KEY=<sk-...>

# Random secret Open WebUI uses to sign sessions.
WEBUI_SECRET_KEY=<random-secret>
